GEMINI_USER_A_KEY=
GEMINI_USER_B_KEY=
GEMINI_USER_C_KEY=
GEMINI_USER_D_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Integrated orchestration: crewai | native | temporal
AGENT_ARMY_ORCHESTRATOR=crewai
AGENT_ARMY_ENV=local
# Fail before accepting work when Docker/OpenHands or enabled production services are unavailable.
AGENT_ARMY_PREFLIGHT_ENABLED=true
# Optional stable request id: retries with the same value reuse the same Temporal workflow/goal.
AGENT_ARMY_REQUEST_ID=
# Optional explicit interpreter for the isolated OpenHands environment.
OPENHANDS_PYTHON=
# Used by the OpenClaw Gateway/skill process; set to the absolute agent-core path.
AGENT_ARMY_CORE_DIR=
# Python interpreter where requirements-crewai.txt is installed.
AGENT_ARMY_CREWAI_PYTHON=

# PostgreSQL goal state. auto uses PostgreSQL whenever a database URL is configured.
AGENT_ARMY_STATE_BACKEND=auto
AGENT_ARMY_DATABASE_URL=postgresql://agent_army:agent_army@127.0.0.1:5432/agent_army

# OpenHands + verification isolation. Pin images; Dependabot can propose controlled updates.
AGENT_ARMY_OPENHANDS_WORKSPACE=docker
AGENT_ARMY_OPENHANDS_SERVER_IMAGE=ghcr.io/openhands/agent-server:1.42.1-python
AGENT_ARMY_VERIFICATION_SANDBOX=docker
AGENT_ARMY_VERIFICATION_IMAGE=ghcr.io/openhands/agent-server:1.42.1-python
AGENT_ARMY_BUILDER_TIMEOUT_SECONDS=3600
AGENT_ARMY_FINAL_VERIFY_TIMEOUT_SECONDS=300
AGENT_ARMY_VERIFY_MEMORY=2g
AGENT_ARMY_VERIFY_CPUS=2
AGENT_ARMY_VERIFY_PIDS=256
AGENT_ARMY_KEEP_WORKSPACE=false

# Temporal durable execution. Production Temporal refuses filesystem state by default.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-army
AGENT_ARMY_TEMPORAL_REQUIRE_POSTGRES=true

# LiteLLM local gateway. The gateway keeps provider credentials out of agent processes.
AGENT_ARMY_LITELLM_ENABLED=false
AGENT_ARMY_LITELLM_PROXY_URL=http://127.0.0.1:4000/v1
AGENT_ARMY_LITELLM_API_KEY=local-agent-army

# Langfuse observability (off unless explicitly enabled)
AGENT_ARMY_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Sentry runtime monitoring (off unless explicitly enabled)
AGENT_ARMY_SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry Collector (off unless explicitly enabled)
AGENT_ARMY_OTEL_ENABLED=false
OTEL_SERVICE_NAME=agent-army
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# GitHub MCP bridge (never commit the real token)
GITHUB_MCP_TOKEN=YOUR_FINE_GRAINED_GITHUB_TOKEN
GITHUB_MCP_ALLOWED_OWNER=Piardian
GITHUB_MCP_ALLOW_CREATE=false
GITHUB_MCP_ALLOW_PUBLIC=false
GITHUB_MCP_HOST=127.0.0.1
GITHUB_MCP_PORT=8765
